{
  "name": "agent-loop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "start": "tsx src/cli.ts",
    "verify:shared-codex": "npm run build && tsx scripts/verify-shared-codex.ts",
    "verify:closeout": "tsx --test test/task-closeout.test.ts",
    "verify:codex": "tsx scripts/verify-codex.ts",
    "verify:inputs": "tsx scripts/verify-inputs.ts",
    "pair:feishu": "tsx scripts/pair-feishu.ts",
    "verify:feishu": "tsx scripts/verify-feishu.ts",
    "verify:runtime": "tsx scripts/verify-runtime.ts",
    "verify:workspace-selection": "tsx scripts/verify-workspace-selection.ts"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "1.76.0",
    "ws": "^8.23.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  }
}
