  "repositories": [
    {
      "name": "crysound/OpenTest",
      "criteria": {
        "states": [
          "open"
        ],
        "assigneesAny": [
          "mingtaojin"
        ],
        "taskTypes": [
          "bug"
        ],
        "labelsAll": [],
        "labelsAny": [],
        "labelsNone": [],
        "nativeTypes": {
          "Bug": "bug",
          "Feature": "feature"
        },
